# Copy to .env and fill in real values locally. Never commit .env.
# These two are bundled into the browser build — safe to expose because
# Row Level Security (not key secrecy) is what enforces access control.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Server-only secrets (Supabase Edge Functions, CI) — NEVER prefix with VITE_
# and never reference from any src/ browser code.
# SUPABASE_SERVICE_ROLE_KEY=
# SUPABASE_DB_URL=
